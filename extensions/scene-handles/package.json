{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "scene-handles",
    "version": "1.0.0",
    "author": "Thanh Hoang",
    "editor": ">=3.8.6",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "tsc && node ./scripts/build.js",
        "watch": "node ./scripts/build.js --watch",
        "typecheck": "tsc",
        "test": "node ./tests/run.js"
    },
    "description": "i18n:scene-handles.description",
    "main": "./dist/main.js",
    "devDependencies": {
        "@cocos/creator-types": "^3.8.6",
        "@types/node": "^18.17.1",
        "typescript": "^5.8.2",
        "esbuild": "^0.24.2"
    },
    "contributions": {
        "asset-db": {
            "mount": {
                "path": "./assets",
                "readonly": false
            }
        },
        "scene": {
            "script": "./dist/scene.js"
        },
        "menu": [
            {
                "path": "i18n:menu.extension/Scene Handles",
                "label": "i18n:scene-handles.menu.toggle",
                "message": "toggle-labels"
            },
            {
                "path": "i18n:menu.extension/Scene Handles",
                "label": "i18n:scene-handles.menu.docs",
                "message": "open-docs"
            }
        ],
        "messages": {
            "toggle-labels": {
                "methods": [
                    "toggleLabels"
                ]
            },
            "open-docs": {
                "methods": [
                    "openDocs"
                ]
            }
        }
    }
}
